local function C_e()
local script = G2L["e"];
	local correctKey = "PremiumKeyByAlex" -- change this to your key
	local submitButton = script.Parent.SubmitButton
	local keyInput = script.Parent.KeyInput
	local statusLabel = script.Parent.StatusLabel
	
	submitButton.MouseButton1Click:Connect(function()
		local input = keyInput.Text
		if input == correctKey then
			statusLabel.Text = "Correct key!"
	
			local success, result = pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/NeonBlade6969/DeadRailsOP/main/Script"))()
			end)
	
			if success then
				print("Script loaded and executed.")
			else
				warn("Failed to run script: " .. tostring(result))
				statusLabel.Text = "Failed to load script."
			end
		else
			statusLabel.Text = "Incorrect key, try again."
		end
	end)
	
end;
